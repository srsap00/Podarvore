rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function entrou() { return request.auth != null; }
    function souEu(uid) { return entrou() && request.auth.uid == uid; }
    // Perfil de administrador deve ser concedido somente pelo Firebase Console/Admin SDK.
    function admin() {
      return entrou()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    match /usuarios/{uid} {
      allow get: if souEu(uid) || admin();
      allow list: if admin();
      allow create: if souEu(uid) && !request.resource.data.keys().hasAny(['role']);
      allow update: if souEu(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow update: if admin();
      allow delete: if false;
    }

    match /denuncias/{id} {
      allow create: if entrou()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.status == 'Pendente'
        && request.resource.data.keys().hasAll(['usuarioId', 'numero', 'descricao', 'localizacao', 'area', 'orgaoResponsavel', 'fotoUrl', 'status', 'criadaEm']);
      allow get, list: if entrou() && (resource.data.usuarioId == request.auth.uid || admin());
      // Usuários não podem alterar status ou inventar resoluções.
      allow update: if admin() && request.resource.data.usuarioId == resource.data.usuarioId;
      allow delete: if admin();
    }
  }
}
